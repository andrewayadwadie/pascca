{
  "name": "@pascca/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/server.ts",
    "build": "echo '@pascca/api runs via tsx, no compiled output needed yet' && exit 0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "openapi:export": "tsx --env-file-if-exists=../../.env scripts/export-openapi.ts",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:reset": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate reset",
    "db:studio": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "fast-jwt": "^5.0.5",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pascca/config": "workspace:*",
    "@pascca/web": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
