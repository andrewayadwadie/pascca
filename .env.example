# PASCca API — environment configuration (contracts/env.md, apps/api/src/config/env.ts)
#
# Copy to .env and fill in real local values. NEVER commit .env — it's gitignored.
# Every key here MUST match apps/api/src/config/env.ts's schema exactly; drift is caught by
# apps/api/tests/env-example-sync.test.ts (FR-008, research R7).

# --- Runtime (all have safe defaults — set explicitly to override) ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL 16 — no default, must be set) ---
DATABASE_URL=postgresql://pascca:pascca@localhost:5432/pascca

# --- Cache (Redis 7 — no default, must be set) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally, Cloudflare R2 in production — S3-compatible, same shape) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=pascca
S3_SECRET_ACCESS_KEY=pascca123
S3_BUCKET=pascca-dev

# --- Security (Article 29 [NN]: comma-separated allow-list, never "*") ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 003-auth-authorization: JWT access-token signing secret and refresh-token cookie signing
# secret. Generate distinct random 32+ char values per environment — never reuse across
# dev/staging/production, never commit a real value here (Article 29 [NN]).
JWT_ACCESS_SECRET=
COOKIE_SECRET=
